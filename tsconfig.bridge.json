{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "declaration": true,
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/bridge/**/*.ts",
    "src/compiler/**/*.ts",
    "src/capture/**/*.ts",
    "src/server/sha256.ts",
    "src/types/**/*.ts",
    "roblox-src/marker-constants.ts",
    "tests/**/*.ts"
  ]
}
